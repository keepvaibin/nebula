# rt_shader_manifest.cmake -DOUT=<header> -DBINARIES=<file|file|...>: the ray tracing shaders' manifest for the start's
# shader preparation (runtime/src/gx/rt_prepare.cpp), from the DXIL containers dxc writes beside each header
# (<header>.dxil): per shader its bytecode array's name, its size and its container digest (the 16 bytes after the
# "DXBC" tag), and the set's fingerprint over every digest. A shader whose bytecode changes changes the fingerprint; a
# change to anything else does not.
cmake_minimum_required(VERSION 3.22)
string(REPLACE "|" ";" binaries "${BINARIES}")
list(REMOVE_ITEM binaries "")
list(SORT binaries)
set(entries "")
set(digests "")
foreach(binary IN LISTS binaries)
    get_filename_component(name "${binary}" NAME)
    string(REGEX REPLACE "\\.h\\.dxil$" "" stem "${name}")
    file(SIZE "${binary}" bytes)
    file(READ "${binary}" tag LIMIT 4 HEX)
    if(NOT tag STREQUAL "44584243")
        message(FATAL_ERROR "${binary}: not a DXIL container")
    endif()
    file(READ "${binary}" digest OFFSET 4 LIMIT 16 HEX)
    string(APPEND entries "    {\"g_${stem}\", ${bytes}u, \"${digest}\"},\n")
    string(APPEND digests "${digest}")
endforeach()
string(SHA256 set_digest "${digests}")
string(SUBSTRING "${set_digest}" 0 16 fingerprint)
list(LENGTH binaries count)
set(text "// Generated by tools/rt_shader_manifest.cmake from the ray tracing shaders' DXIL containers: do not edit.\n")
string(APPEND text "#pragma once\n\n#include <cstdint>\n\nnamespace galaxy::gx {\n\n")
string(APPEND text "struct RtShaderManifestEntry {\n    const char* name;     // its bytecode array\n")
string(APPEND text "    std::uint32_t bytes;\n    const char* digest;   // its container digest, 32 hex digits\n};\n\n")
string(APPEND text "inline constexpr std::uint64_t kRtShaderSetFingerprint = 0x${fingerprint}ull;\n")
string(APPEND text "inline constexpr RtShaderManifestEntry kRtShaderManifest[${count}] = {\n${entries}};\n\n")
string(APPEND text "}  // namespace galaxy::gx\n")
# Written only when it changes, so what includes it rebuilds only for a shader change.
if(EXISTS "${OUT}")
    file(READ "${OUT}" previous)
    if(previous STREQUAL text)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${text}")
