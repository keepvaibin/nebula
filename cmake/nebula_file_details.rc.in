@NEBULA_RC_ICON@
1 VERSIONINFO
FILEVERSION @NEBULA_RC_MAJOR@,@NEBULA_RC_MINOR@,@NEBULA_RC_PATCH@,0
PRODUCTVERSION @NEBULA_RC_MAJOR@,@NEBULA_RC_MINOR@,@NEBULA_RC_PATCH@,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "keepvaibin"
      VALUE "FileDescription", "@NEBULA_RC_DESCRIPTION@"
      VALUE "FileVersion", "@NEBULA_RC_MAJOR@.@NEBULA_RC_MINOR@.@NEBULA_RC_PATCH@"
      VALUE "LegalCopyright", "Copyright 2026 keepvaibin"
      VALUE "OriginalFilename", "@NEBULA_RC_FILE@"
      VALUE "ProductName", "Nebula"
      VALUE "ProductVersion", "@NEBULA_RC_MAJOR@.@NEBULA_RC_MINOR@.@NEBULA_RC_PATCH@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
