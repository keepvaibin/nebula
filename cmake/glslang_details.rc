// glslang's command-line compiler as Nebula ships it (cmake/vulkan_deps.cmake): its own file details, Khronos's.
1 VERSIONINFO
FILEVERSION 16,6,0,0
PRODUCTVERSION 16,6,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "The Khronos Group Inc."
      VALUE "FileDescription", "glslang shader compiler"
      VALUE "FileVersion", "16.6.0"
      VALUE "LegalCopyright", "Copyright The Khronos Group Inc. and glslang's contributors (LICENSE.txt)"
      VALUE "OriginalFilename", "glslang.exe"
      VALUE "ProductName", "glslang"
      VALUE "ProductVersion", "16.6.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
