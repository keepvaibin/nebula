{
  "harness": 1,
  "name": "3301-material-spheres",
  "about": "jt-spheres attaches its two glTF spheres beside the player: metal (base 0.95, metal 1, roughness 0.05) on the player's right (x -130; the picture's right with the camera behind), rough (red, metal 0, roughness 0.8) on the left, cooked at install from the mod's assets; both drawn, neither the placeholder. Pictures before and after the player turns (raster, no tracing): the metal sphere reflects the stage's light as a sky above a sharp horizon and a dark ground below (program_pbr.hlsli pbr_environment; the scene itself where the tracer owns the pixel) with one sharp highlight; the red one is evenly shaded with a broad dim highlight (a person's look, then the references). Each sphere has its own box: its picture like the reference's there, and its colours measured: the red one red, the metal one light in a band above its middle (the sky) and near black in a band below (the ground), in both pictures",
  "proves": [
    "material.lit",
    "material.metal",
    "material.rough",
    "material.environment"
  ],
  "mods": [
    "../mods/jt-spheres"
  ],
  "stage": {
    "name": "EggStarGalaxy",
    "scenario": 1
  },
  "steps": [
    {
      "at": 60,
      "call": "MR::getRandom",
      "signature": "s32(s32, s32)",
      "args": [
        0,
        3301
      ]
    },
    {
      "at": 120,
      "picture": "front"
    },
    {
      "at": 130,
      "stick": [
        1,
        0
      ],
      "frames": 50
    },
    {
      "at": 220,
      "picture": "turned"
    },
    {
      "at": 240,
      "end": true
    }
  ],
  "expect": [
    {
      "fact": "mod.jt-spheres.metal",
      "is": 0
    },
    {
      "fact": "mod.jt-spheres.rough",
      "is": 0
    },
