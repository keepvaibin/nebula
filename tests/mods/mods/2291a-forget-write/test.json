    "../mods/fg-user",
    "../../save/mods/save-a"
  ],
  "stage": {
    "name": "EggStarGalaxy",
    "scenario": 1
  },
  "steps": [
    {
      "call": "MR::getRandom",
      "signature": "s32(s32, s32)",
      "args": [
        0,
        4290
      ],
      "at": 10
    },
    {
      "call": "MR::getRandom",
      "signature": "s32(s32, s32)",
      "args": [
        0,
        4259
      ],
      "at": 20
    },
    {
      "after": {
