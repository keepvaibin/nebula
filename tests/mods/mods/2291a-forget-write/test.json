        "is": 1
      },
      "hold": [
        "RIGHT"
      ],
      "frames": 4
    },
    {
      "after": {
        "fact": "mod.save-a.focused",
        "is": 1
      },
      "hold": [
        "A"
      ],
      "frames": 4
    },
    {
      "after": {
        "fact": "mod.save-a.done_ready",
        "is": 1
      },
      "hold": [
        "A"
      ],
      "frames": 4
    },
    {
