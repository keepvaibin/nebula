{
  "harness": 1,
  "name": "2104-svc-other-major",
  "about": "An import of 2.0 (another major) is refused with L505 naming test.svc 2.0",
  "proves": [
    "kernel.service",
    "kernel.refusal",
    "services.registry"
  ],
  "mods": [
    {
      "path": "../mods/reg-svc20",
      "loads": false
    }
  ],
  "steps": [
    {
      "at": 30,
      "end": true
    }
  ],
  "expect": [
    {
      "fact": "mod.reg-svc20.started",
      "absent": true
    },
    {
      "fact": "modlog",
      "has": {
        "mod": "reg-svc20",
        "source": "validator",
        "level": "error",
        "code": 505,
        "file": "code/windows-x64/mod.dll",
        "text": "reg-svc20: code/windows-x64/mod.dll: the game has no service \"test.svc\" at version 2.0 or a later one with the same major number."
      },
      "when": "any",
      "systems": [
        "windows"
      ]
    },
    {
      "fact": "modlog",
      "has": {
        "mod": "reg-svc20",
        "source": "validator",
        "level": "error",
        "code": 505,
        "file": "code/linux-x64/mod.so",
        "text": "reg-svc20: code/linux-x64/mod.so: the game has no service \"test.svc\" at version 2.0 or a later one with the same major number."
      },
      "when": "any",
      "systems": [
        "linux"
      ]
    }
  ]
}
