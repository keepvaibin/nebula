{
  "harness": 1,
  "name": "2103-svc-newer-minor",
  "about": "An import of 1.4 (newer than the provider's 1.3) is refused with L505 naming test.svc 1.4",
  "proves": [
    "kernel.service",
    "kernel.refusal",
    "services.registry"
  ],
  "mods": [
    {
      "path": "../mods/reg-svc14",
      "loads": false
    }
  ],
  "steps": [
    {
      "at": 30,
      "end": true
    }
  ],
  "expect": [
    {
      "fact": "mod.reg-svc14.started",
      "absent": true
    },
    {
      "fact": "modlog",
      "has": {
        "mod": "reg-svc14",
        "source": "validator",
        "level": "error",
        "code": 505,
        "file": "code/windows-x64/mod.dll",
        "text": "reg-svc14: code/windows-x64/mod.dll: the game has no service \"test.svc\" at version 1.4 or a later one with the same major number."
      },
      "when": "any",
      "systems": [
        "windows"
      ]
    },
    {
      "fact": "modlog",
      "has": {
        "mod": "reg-svc14",
        "source": "validator",
        "level": "error",
        "code": 505,
        "file": "code/linux-x64/mod.so",
        "text": "reg-svc14: code/linux-x64/mod.so: the game has no service \"test.svc\" at version 1.4 or a later one with the same major number."
      },
      "when": "any",
      "systems": [
        "linux"
      ]
    }
  ]
}
