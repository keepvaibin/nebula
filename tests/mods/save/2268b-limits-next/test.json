{
  "harness": 1,
  "name": "2268b-limits-next",
  "about": "the next run loads the 960 KiB file (past the old read buffer): every value back byte for byte, the file's own game data (an event value set by the harness) loaded, no damaged-save screen",
  "proves": [
    "services.save"
  ],
  "mods": [
    "../mods/save-a",
    "../mods/save-b",
    "../mods/save-c",
    "../mods/save-d",
    "../mods/save-e"
  ],
