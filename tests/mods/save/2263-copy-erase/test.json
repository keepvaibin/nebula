      "call": "MR::getRandom",
      "signature": "s32(s32, s32)",
      "args": [
        0,
        4251
      ]
    },
    {
      "at": 20,
      "call": "MR::getRandom",
      "signature": "s32(s32, s32)",
      "args": [
        0,
        4259
      ]
    },
    {
      "after": {
        "fact": "mod.save-a.confirm_ready",
