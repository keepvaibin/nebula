        "is": 1
      },
      "hold": [
        "A"
      ],
      "frames": 4
    },
    {
      "after": {
        "fact": "mod.save-a.done_ready",
        "is": 1
      },
      "hold": [
        "A"
      ],
      "frames": 4
    },
    {
      "after": {
