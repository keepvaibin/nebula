{
  "harness": 1,
  "name": "2510-text",
  "about": "in-text: the refusals; a NAME request of 8 starts \"Gold Mar\"; a second request ends it CANCELLED; A held while open reaches neither the game nor the mod; cancel; then a NUMBER request of 6 typed \"-12.5a3x\", Backspace, \"9\", Enter gives \"-12.59\"; A after it reaches the game",
  "proves": [
    "services.input"
  ],
  "mods": [
    "../mods/in-text"
  ],
  "stage": {
    "name": "EggStarGalaxy",
    "scenario": 1
  },
  "steps": [
    {
      "after": {
        "fact": "mod.in-text.running",
        "exists": true
      },
      "hold": [
        "A"
      ],
      "frames": 60
    },
    {
      "after": {
        "fact": "mod.in-text.third_request",
        "exists": true
      },
      "text": "-12.5a3x"
    },
    {
      "after": {
        "fact": "mod.in-text.third_request",
        "exists": true
      },
      "key": "backspace"
    },
    {
      "after": {
        "fact": "mod.in-text.third_request",
        "exists": true
      },
      "text": "9"
    },
    {
      "after": {
        "fact": "mod.in-text.third_request",
        "exists": true
      },
      "key": "enter"
    },
    {
      "after": {
        "fact": "mod.in-text.third_status",
        "exists": true
      },
      "hold": [
        "A"
      ],
      "frames": 30
    },
    {
      "after": {
        "fact": "mod.in-text.a_after",
        "at_least": 1
      },
      "end": true,
