{
  "harness": 1,
  "name": "6703-start-crash-again",
  "about": "Not kept off, crash-start starts again at the start after and crashes again",
  "proves": [
    "mods.after_crash.named"
  ],
  "continue_from": "6702-start-crash-next",
  "ends": "crash",
  "mods": [
    {
      "path": "../mods/crash-start",
