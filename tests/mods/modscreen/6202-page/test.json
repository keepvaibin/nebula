{
  "harness": 1,
  "name": "6202-page",
  "about": "The mod's page through DETAILS: each of its rows as a fact (line 0 its name), the list line first",
  "proves": [
    "modscreen.page"
  ],
  "mods": [
    {
      "path": "../../consent/mods/jc-none",
      "code": "ask",
      "loads": false
    }
  ],
  "steps": [
    {
      "at": 120,
      "settings": "mods"
    },
    {
      "at": 180,
      "key": "up"
    },
    {
      "at": 240,
      "key": "up"
    },
    {
      "at": 300,
      "key": "up"
    },
    {
      "at": 360,
      "key": "down"
    },
    {
      "at": 420,
      "key": "down"
    },
    {
      "at": 480,
      "key": "down"
    },
    {
      "at": 540,
      "key": "left"
    },
    {
      "at": 600,
      "key": "left"
    },
    {
      "at": 660,
      "key": "left"
    },
    {
      "at": 720,
      "key": "left"
    },
    {
      "at": 780,
      "key": "right"
    },
    {
      "at": 840,
      "key": "right"
    },
    {
      "at": 900,
      "key": "space"
    },
    {
      "at": 1140,
      "end": true
    }
  ],
  "expect": [
    {
      "fact": "modscreen.jc-none",
      "has": {
        "line": 0,
        "page": "list"
      },
      "when": "first",
      "scope": "installation"
    },
    {
      "fact": "modscreen.jc-none",
      "has": {
        "line": 0,
        "page": "page"
      },
      "when": "any",
      "scope": "installation"
    },
    {
      "fact": "modscreen.jc-none",
      "has": {
        "line": 1,
        "page": "page"
      },
      "when": "any",
      "scope": "installation"
    }
  ]
}
