{
  "harness": 1,
  "name": "2253-option-read",
  "about": "each option kind at the manifest's default as text: a choice's value, a number as the page lists it, a toggle 1, a text in UTF-8, a key's control; the length with a null buf",
  "proves": [
    "services.mods"
  ],
  "mods": [
    "../mods/opt-read"
  ],
  "steps": [
    {
      "at": 10,
      "call": "MR::getRandom",
      "signature": "s32(s32, s32)",
      "args": [
        0,
        4401
      ]
    },
    {
      "at": 20,
      "end": true
    }
  ],
  "expect": [
    {
      "fact": "mod.opt-read.len_lives",
      "is": 5
    },
    {
      "fact": "mod.opt-read.got_lives",
      "is": 5
    },
    {
      "fact": "mod.opt-read.same_lives",
      "is": 1
    },
    {
      "fact": "mod.opt-read.len_speed",
      "is": 3
    },
    {
      "fact": "mod.opt-read.got_speed",
      "is": 3
    },
    {
      "fact": "mod.opt-read.same_speed",
      "is": 1
    },
    {
      "fact": "mod.opt-read.len_hard",
      "is": 1
    },
    {
      "fact": "mod.opt-read.got_hard",
      "is": 1
    },
    {
      "fact": "mod.opt-read.same_hard",
      "is": 1
    },
    {
      "fact": "mod.opt-read.len_label",
      "is": 6
    },
    {
      "fact": "mod.opt-read.got_label",
      "is": 6
    },
    {
      "fact": "mod.opt-read.same_label",
      "is": 1
    },
    {
      "fact": "mod.opt-read.len_jump",
      "is": 1
    },
    {
      "fact": "mod.opt-read.got_jump",
      "is": 1
    },
    {
      "fact": "mod.opt-read.same_jump",
      "is": 1
    }
  ]
}
