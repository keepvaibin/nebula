{
  "harness": 1,
  "name": "3129-entry-whole",
  "about": "Mods > Log > jl-repeat's entry opened by space: the window holds its whole text, one page",
  "proves": [
    "modlog.entry"
  ],
  "mods": [
    "../mods/jl-repeat"
  ],
  "steps": [
    {
      "at": 120,
      "settings": "mods"
    },
    {
      "at": 180,
      "key": "up"
    },
    {
      "at": 240,
      "key": "up"
    },
    {
      "at": 300,
      "key": "up"
    },
    {
      "at": 360,
      "key": "down"
    },
    {
      "at": 420,
      "key": "down"
    },
    {
      "at": 480,
      "key": "space"
    },
    {
      "at": 540,
      "key": "space"
    },
    {
      "at": 660,
      "end": true
    }
  ],
  "expect": [
    {
      "fact": "modlog.entry",
      "has": {
        "mod": "jl-repeat",
        "pages": 1
      },
      "when": "any",
      "scope": "installation"
    },
    {
      "fact": "modlog.entry",
      "count": 1,
      "scope": "installation"
    }
  ]
}
