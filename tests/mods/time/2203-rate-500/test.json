{
  "harness": 1,
  "name": "2203-rate-500",
  "about": "Rate 500: steps 0, 1, 0, 1 (one in every two frames), the sound at 500",
  "proves": [
    "services.time"
  ],
  "mods": [
    "../mods/tm-r500"
  ],
  "stage": {
    "name": "EggStarGalaxy",
    "scenario": 1
  },
  "steps": [
    {
      "at": 5,
      "call": "MR::getRandom",
      "signature": "s32(s32, s32)",
      "args": [
        0,
        4220
      ]
    },
    {
      "at": 10,
      "call": "MR::getRandom",
      "signature": "s32(s32, s32)",
      "args": [
        0,
        4221
      ]
    },
    {
      "at": 40,
      "end": true
    }
  ],
  "expect": [
    {
      "fact": "mod.tm-r500.set",
      "is": 0
    },
    {
      "fact": "mod.tm-r500.ds",
      "at_most": 1,
      "when": "all",
      "frames": [
        14,
        38
      ]
    },
    {
      "fact": "mod.tm-r500.steps",
      "at_most": 1,
      "when": "all",
      "frames": [
        14,
        38
      ]
    },
    {
      "fact": "mod.tm-r500.steps",
      "is": 0,
      "when": "any",
      "frames": [
        14,
        38
      ]
    },
    {
      "fact": "mod.tm-r500.steps",
      "is": 1,
      "when": "any",
      "frames": [
        14,
        38
      ]
    },
    {
      "fact": "mod.tm-r500.ds2",
      "is": 1,
      "when": "all",
      "frames": [
        16,
        38
      ]
    },
    {
      "fact": "mod.tm-r500.rate",
      "is": 500,
      "when": "all",
      "frames": [
        16,
        38
      ]
    },
    {
      "fact": "mod.tm-r500.sound",
      "is": 500,
      "when": "all",
      "frames": [
        16,
        38
      ]
    }
  ]
}
