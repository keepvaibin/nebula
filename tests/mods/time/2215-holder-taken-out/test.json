{
  "harness": 1,
  "name": "2215-holder-taken-out",
  "about": "The mod that holds taken out (harness r7 take_out): from the next frame the world steps again, holders 0, the sound back",
  "proves": [
    "services.time"
  ],
  "mods": [
    "../mods/tm-hold",
    "../mods/tm-basic"
  ],
  "stage": {
    "name": "EggStarGalaxy",
    "scenario": 1
  },
  "steps": [
    {
      "at": 5,
      "call": "MR::getRandom",
      "signature": "s32(s32, s32)",
      "args": [
        0,
        4220
      ]
    },
    {
      "at": 10,
      "call": "MR::getRandom",
      "signature": "s32(s32, s32)",
      "args": [
        0,
        4221
      ]
    },
    {
      "at": 20,
      "take_out": "tm-hold"
    },
    {
      "at": 40,
      "end": true
    }
  ],
  "expect": [
    {
      "fact": "mod.tm-basic.ds",
      "is": 0,
      "when": "all",
      "frames": [
        13,
        19
      ]
    },
    {
      "fact": "mod.tm-basic.holders",
      "is": 1,
      "when": "all",
      "frames": [
        13,
        19
      ]
    },
    {
      "fact": "mod.tm-basic.ds",
      "is": 1,
      "when": "all",
      "frames": [
        23,
        38
      ]
    },
    {
      "fact": "mod.tm-basic.steps",
      "is": 1,
      "when": "all",
      "frames": [
        23,
        38
      ]
    },
    {
      "fact": "mod.tm-basic.holders",
      "is": 0,
      "when": "all",
      "frames": [
        23,
        38
      ]
    },
    {
      "fact": "mod.tm-basic.sound",
      "is": 1000,
      "when": "all",
      "frames": [
        23,
        38
      ]
    },
    {
      "fact": "takeout.tm-hold",
      "has": {
        "stopped": true,
        "finished": true
      }
    }
  ]
}
