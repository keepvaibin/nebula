{
  "harness": 1,
  "name": "2201-now",
  "about": "Nothing set: frame and step grow by 1 a frame, one on_step call a frame, state PLAY, rate 1000",
  "proves": [
    "services.time",
    "services.time.handlers"
  ],
  "mods": [
    "../mods/tm-basic"
  ],
  "stage": {
    "name": "EggStarGalaxy",
    "scenario": 1
  },
  "steps": [
    {
      "at": 5,
      "call": "MR::getRandom",
      "signature": "s32(s32, s32)",
      "args": [
        0,
        4220
      ]
    },
    {
      "at": 40,
      "end": true
    }
  ],
  "expect": [
