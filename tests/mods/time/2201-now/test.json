    {
      "fact": "mod.tm-basic.on_step",
      "is": 0
    },
    {
      "fact": "mod.tm-basic.df",
      "is": 1,
      "when": "all",
      "frames": [
        8,
        38
      ]
    },
    {
      "fact": "mod.tm-basic.ds",
      "is": 1,
      "when": "all",
      "frames": [
        8,
        38
      ]
    },
    {
      "fact": "mod.tm-basic.steps",
      "is": 1,
      "when": "all",
      "frames": [
        8,
        38
      ]
    },
    {
      "fact": "mod.tm-basic.state",
      "is": 2,
      "when": "all",
      "frames": [
        8,
        38
      ]
    },
    {
      "fact": "mod.tm-basic.rate",
      "is": 1000,
      "when": "all",
      "frames": [
        8,
        38
      ]
    },
    {
      "fact": "mod.tm-basic.holders",
      "is": 0,
      "when": "all",
      "frames": [
        8,
        38
      ]
    },
    {
      "fact": "mod.tm-basic.sound",
      "is": 1000,
      "when": "all",
      "frames": [
        8,
        38
      ]
    },
    {
      "fact": "mod.tm-basic.calls",
      "is": 1,
      "when": "all",
      "frames": [
        8,
        38
      ]
    },
    {
      "fact": "mod.tm-basic.sif",
      "is": 0,
      "when": "all",
      "frames": [
        8,
        38
      ]
    }
  ]
