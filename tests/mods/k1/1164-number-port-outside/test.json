{
  "harness": 1,
  "name": "1164-number-port-outside",
  "about": "70000 kept for the port option is outside its range: it reads its default 16834, said once",
  "proves": [
    "services.mods"
  ],
  "mods": [
    {
      "path": "../mods/k1-port",
      "options": {
        "port": 70000
      }
    }
  ],
  "steps": [
    {
      "at": 10,
      "call": "MR::getRandom",
      "signature": "s32(s32, s32)",
      "args": [
        0,
        4462
      ]
    },
    {
      "at": 20,
      "end": true
    }
  ],
  "expect": [
    {
      "fact": "mod.k1-port.status",
      "is": 5
    },
    {
      "fact": "mod.k1-port.port",
      "is": 16834
    },
    {
      "fact": "mod.k1-port.len",
      "is": 5
    },
    {
      "log": "k1-port: the value kept for its option port \\(70000\\) is not one of its values; it reads 16834",
      "times": 1
    }
  ]
}
