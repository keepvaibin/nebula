{
  "harness": 1,
  "name": "1102-replace-top-reversed",
  "about": "The same two replaces the other way round: the other mod holds it",
  "proves": [
    "kernel.hook.replace",
    "kernel.refusal"
  ],
  "mods": [
    "../mods/lt-rep2",
    {
      "path": "../mods/lt-rep1",
      "loads": false
    }
  ],
  "steps": [
    {
      "at": 30,
      "call": "MR::getPlayerLeft",
      "signature": "s32()",
      "args": [],
      "fact": "left"
    },
    {
      "at": 40,
      "end": true
    }
  ],
  "expect": [
    {
      "fact": "left",
      "is": 200
    },
    {
      "fact": "mod.lt-rep1.started",
      "absent": true
    },
    {
      "fact": "modlog",
      "has": {
        "mod": "lt-rep1",
        "source": "validator",
        "level": "error",
        "code": 805,
        "file": "code/windows-x64/mod.dll",
        "text": "lt-rep1: code/windows-x64/mod.dll replaces \"MR::getPlayerLeft\" (s32()), which lt-rep2 replaces already; only one mod may replace a function."
      },
      "when": "any",
      "systems": [
        "windows"
      ]
    },
    {
      "fact": "modlog",
      "has": {
        "mod": "lt-rep1",
        "source": "validator",
        "level": "error",
        "code": 805,
        "file": "code/linux-x64/mod.so",
        "text": "lt-rep1: code/linux-x64/mod.so replaces \"MR::getPlayerLeft\" (s32()), which lt-rep2 replaces already; only one mod may replace a function."
      },
      "when": "any",
      "systems": [
        "linux"
      ]
    }
  ]
}
