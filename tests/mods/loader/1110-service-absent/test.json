{
  "harness": 1,
  "name": "1110-service-absent",
  "about": "A required service the game does not have refuses the mod, naming it (L505)",
  "proves": [
    "kernel.service",
    "kernel.refusal"
  ],
  "mods": [
    {
      "path": "../mods/lt-svc-none",
      "loads": false
    }
  ],
  "steps": [
    {
      "at": 30,
      "end": true
    }
  ],
  "expect": [
    {
      "fact": "mod.lt-svc-none.started",
      "absent": true
    },
    {
      "fact": "modlog",
      "has": {
        "mod": "lt-svc-none",
        "source": "validator",
        "level": "error",
        "code": 505,
        "file": "code/windows-x64/mod.dll",
        "text": "lt-svc-none: code/windows-x64/mod.dll: the game has no service \"lt.absent\" at version 1.0 or a later one with the same major number."
      },
      "when": "any",
      "systems": [
        "windows"
      ]
    },
    {
      "fact": "modlog",
      "has": {
        "mod": "lt-svc-none",
        "source": "validator",
        "level": "error",
        "code": 505,
        "file": "code/linux-x64/mod.so",
        "text": "lt-svc-none: code/linux-x64/mod.so: the game has no service \"lt.absent\" at version 1.0 or a later one with the same major number."
      },
      "when": "any",
      "systems": [
        "linux"
      ]
    }
  ]
}
