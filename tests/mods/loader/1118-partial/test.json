{
  "harness": 1,
  "name": "1118-partial",
  "about": "A mod binds whole or not at all: a missing name refuses it and its hook is not left behind",
  "proves": [
    "kernel.bind",
    "kernel.refusal"
  ],
  "mods": [
    {
      "path": "../mods/lt-partial",
      "loads": false
    }
  ],
  "steps": [
    {
      "at": 30,
      "call": "MR::getRandom",
      "signature": "s32(s32, s32)",
      "args": [
        4249,
        4249
      ],
      "fact": "r"
    },
    {
      "at": 40,
      "end": true
    }
  ],
  "expect": [
    {
      "fact": "r",
      "is": 4249
    },
    {
      "fact": "mod.lt-partial.started",
      "absent": true
    },
    {
      "fact": "modlog",
      "has": {
        "mod": "lt-partial",
        "source": "validator",
        "level": "error",
        "code": 505,
        "file": "code/windows-x64/mod.dll",
        "text": "lt-partial: code/windows-x64/mod.dll: the game has no function \"MR::ltNoSuchFunction\" with the signature \"void()\"."
      },
      "when": "any",
      "systems": [
        "windows"
      ]
    },
    {
      "fact": "modlog",
      "has": {
        "mod": "lt-partial",
        "source": "validator",
        "level": "error",
        "code": 505,
        "file": "code/linux-x64/mod.so",
        "text": "lt-partial: code/linux-x64/mod.so: the game has no function \"MR::ltNoSuchFunction\" with the signature \"void()\"."
      },
      "when": "any",
      "systems": [
        "linux"
      ]
    }
  ]
}
