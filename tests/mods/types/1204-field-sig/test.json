{
  "harness": 1,
  "name": "1204-field-sig",
  "about": "A field asked with another type text is refused (Z-4, Name.FieldSig)",
  "proves": [
    "kernel.refusal",
    "kernel.bind"
  ],
  "mods": [
    {
      "path": "../mods/tt-sig-field",
      "loads": false
    }
  ],
  "steps": [
    {
      "at": 30,
      "end": true
    }
  ],
  "expect": [
    {
      "fact": "mod.tt-sig-field.started",
      "absent": true
    },
    {
      "fact": "modlog",
      "has": {
        "mod": "tt-sig-field",
        "source": "validator",
        "level": "error",
        "code": 505,
        "file": "code/windows-x64/mod.dll",
        "text": "tt-sig-field: code/windows-x64/mod.dll: the game has no field \"Vec3<f32>.x\" of type \"s32\"."
      },
      "when": "any",
      "systems": [
        "windows"
      ]
    },
    {
      "fact": "modlog",
      "has": {
        "mod": "tt-sig-field",
        "source": "validator",
        "level": "error",
        "code": 505,
        "file": "code/linux-x64/mod.so",
        "text": "tt-sig-field: code/linux-x64/mod.so: the game has no field \"Vec3<f32>.x\" of type \"s32\"."
      },
      "when": "any",
      "systems": [
        "linux"
      ]
    }
  ]
}
