{
  "harness": 1,
  "name": "6606-notice-unspaced",
  "about": "The after-crash notice over the Mods lists in Japanese (no spaces to break at) in a 4:3 window",
  "proves": [
    "mods.safe_start.crash"
  ],
  "mods": [
    {
      "path": "../../consent/mods/jc-none",
      "code": "ask",
      "loads": false
    }
  ],
  "safe_start": "crash",
  "language": "JpJapanese",
  "disc": "RMGJ01",
  "window": [
    960,
    720
  ],
  "renderers": [
    "d3d12",
    "vulkan",
    "d3d11"
  ],
  "steps": [
    {
      "at": 120,
      "settings": "mods"
    },
    {
      "at": 240,
      "picture": "mods"
    },
    {
      "at": 270,
      "end": true
    }
  ],
  "expect": [
    {
      "fact": "modscreen.nebula",
      "has": {
        "line": 0,
        "page": "list"
      },
      "when": "any",
      "scope": "installation"
    },
    {
      "picture": "mods",
      "like": "refs/{renderer}/mods.png",
      "within": {
        "rmse": 0.5
      }
    }
  ]
}
