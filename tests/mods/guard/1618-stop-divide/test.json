{
  "harness": 1,
  "name": "1618-stop-divide",
  "about": "guard-6-3 faults (divide) in its stop when the harness takes it out: caught, the take-out completes, the game goes on",
  "proves": [
    "kernel.guard.resume",
    "kernel.guard.boundaries"
  ],
  "mods": [
    "../mods/guard-6-3"
  ],
  "stage": {
    "name": "EggStarGalaxy",
    "scenario": 1
  },
  "steps": [
    {
      "at": 150,
      "take_out": "guard-6-3",
      "wait": true
    },
    {
      "after": {
        "fact": "takeout.guard-6-3",
        "exists": true
      },
      "call": "MR::getRandom",
      "signature": "s32(s32, s32)",
      "args": [
        0,
        1618
      ],
      "fact": "after"
    },
    {
      "after": {
        "fact": "after",
        "exists": true
      },
      "end": true
    }
  ],
  "expect": [
    {
      "fact": "mod.guard-6-3.entered",
      "count": 1
    },
    {
      "fact": "mod.guard-6-3.survived",
      "absent": true
    },
    {
      "fact": "mod.guard-6-3.again",
      "absent": true
    },
    {
      "log": "\\[mod guard-6-3\\] GUARD: its code failed \\(stop: stop\\): a division by zero at .+\\+0x[0-9a-f]+, address 0x[0-9a-f]+\\. It is off until the next start; what it was changing may be half done\\."
    },
    {
      "fact": "modlog",
      "has": {
        "mod": "guard-6-3",
        "source": "guard",
        "level": "error",
        "code": 3
      },
      "when": "any"
    },
    {
      "fact": "mod.guard-6-3.quotient",
      "absent": true
    },
    {
      "fact": "mod.guard-6-3.started",
      "is": 1
    },
    {
      "fact": "takeout.guard-6-3",
      "exists": true
    },
    {
      "fact": "after",
      "exists": true
    }
  ],
  "faults": [
    {
      "mod": "guard-6-3"
    }
  ]
}
