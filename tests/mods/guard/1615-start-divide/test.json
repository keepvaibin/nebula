{
  "harness": 1,
  "name": "1615-start-divide",
  "about": "guard-5-3 faults in its start (divide): the start is refused (Validator.Lib.StartFaulted), the mod log has its GUARD entry, the game goes on",
  "proves": [
    "kernel.guard.resume",
    "kernel.guard.boundaries"
  ],
  "mods": [
    {
      "path": "../mods/guard-5-3",
      "loads": false
    }
  ],
  "stage": {
    "name": "EggStarGalaxy",
    "scenario": 1
  },
  "steps": [
    {
      "at": 200,
      "call": "MR::getRandom",
      "signature": "s32(s32, s32)",
      "args": [
        0,
        1615
      ],
      "fact": "after"
    },
    {
      "at": 260,
      "end": true
    }
  ],
  "expect": [
    {
      "fact": "mod.guard-5-3.entered",
      "count": 1
    },
    {
      "fact": "mod.guard-5-3.survived",
      "absent": true
    },
    {
      "fact": "mod.guard-5-3.again",
      "absent": true
    },
    {
      "log": "\\[mod guard-5-3\\] GUARD: its code failed \\(start: start\\): a division by zero at .+\\+0x[0-9a-f]+, address 0x[0-9a-f]+\\. It is off until the next start; what it was changing may be half done\\."
    },
    {
      "fact": "modlog",
      "has": {
        "mod": "guard-5-3",
        "source": "guard",
        "level": "error",
        "code": 3
      },
      "when": "any"
    },
    {
      "fact": "mod.guard-5-3.quotient",
      "absent": true
    },
    {
      "fact": "mod.guard-5-3.started",
      "absent": true
    },
    {
      "log": "guard-5-3.*its begin or start failed and the guard stopped it"
    },
    {
      "fact": "after",
      "exists": true
    }
  ],
  "faults": [
    {
      "mod": "guard-5-3"
    }
  ]
}
