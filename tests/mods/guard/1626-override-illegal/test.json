{
  "harness": 1,
  "name": "1626-override-illegal",
  "about": "guard-9-2 faults (illegal) in GuardShell's override of LiveActor::calcAnim, before it proceeds: caught at the boundary, the mod off and taken out at the next frame, GUARD in the log and the mod log, the game goes on",
  "proves": [
    "kernel.guard.resume",
    "kernel.guard.boundaries"
  ],
  "mods": [
    "../mods/guard-9-2"
  ],
  "stage": {
    "name": "EggStarGalaxy",
    "scenario": 1
  },
  "steps": [
    {
      "after": {
        "fact": "takeout.guard-9-2",
        "exists": true
      },
      "call": "MR::getRandom",
      "signature": "s32(s32, s32)",
      "args": [
        0,
        1626
      ],
      "fact": "after"
    },
    {
      "after": {
        "fact": "after",
        "exists": true
      },
      "end": true
    }
  ],
  "expect": [
    {
      "fact": "mod.guard-9-2.entered",
      "count": 1
    },
    {
      "fact": "mod.guard-9-2.survived",
      "absent": true
    },
    {
      "fact": "mod.guard-9-2.again",
      "absent": true
    },
    {
      "log": "\\[mod guard-9-2\\] GUARD: its code failed \\(class: LiveActor::calcAnim\\): an instruction the processor refuses at .+\\+0x[0-9a-f]+, address 0x[0-9a-f]+\\. It is off until the next start; what it was changing may be half done\\."
    },
    {
      "fact": "modlog",
      "has": {
        "mod": "guard-9-2",
        "source": "guard",
        "level": "error",
        "code": 2
      },
      "when": "any"
    },
    {
      "fact": "mod.guard-9-2.started",
      "is": 1
    },
    {
      "fact": "takeout.guard-9-2",
      "exists": true
    },
    {
      "fact": "after",
      "exists": true
    },
    {
      "fact": "mod.guard-9-2.defined",
      "is": 1
    }
  ],
  "faults": [
    {
      "mod": "guard-9-2"
    }
  ]
}
