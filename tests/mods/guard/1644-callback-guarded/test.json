{
  "harness": 1,
  "name": "1644-callback-guarded",
  "about": "guard-cb-lib's after hook calls the callbacks it keeps through LumaCore.call_mod: guard-cb-bad's faults under guard-cb-bad's own boundary, so guard-cb-bad is off (call_mod answers -1) and guard-cb-lib goes on to guard-cb-good's callback in the same call (answer 0, ran 1). guard-cb-lib is not cut (its code is not on the cut stack) and stays; guard-cb-good stays",
  "proves": [
    "kernel.guard.callback",
    "kernel.guard.need_walk"
  ],
  "mods": [
    "../mods/guard-cb-lib",
    "../mods/guard-cb-bad",
    "../mods/guard-cb-good"
  ],
  "stage": {
    "name": "EggStarGalaxy",
    "scenario": 1
  },
  "steps": [
    {
      "at": 30,
      "call": "MR::getRandom",
      "signature": "s32(s32, s32)",
      "args": [
        0,
        1644
      ]
    },
    {
      "call": "MR::getRandom",
      "signature": "s32(s32, s32)",
      "args": [
        0,
        1645
      ],
      "after": {
        "fact": "takeout.guard-cb-bad",
        "exists": true
      },
      "fact": "after"
    },
    {
      "after": {
        "fact": "after",
        "exists": true
      },
      "end": true
    }
  ],
  "expect": [
    {
      "fact": "mod.guard-cb-lib.r0",
      "is": -1
    },
    {
      "fact": "mod.guard-cb-lib.r1",
      "is": 0
    },
    {
      "fact": "mod.guard-cb-lib.ran_all",
      "count": 2
    },
    {
      "fact": "mod.guard-cb-good.ran",
      "count": 2
    },
    {
      "fact": "mod.guard-cb-bad.entered",
      "count": 1
    },
    {
      "fact": "mod.guard-cb-bad.survived",
      "absent": true
    },
    {
      "log": "\\[mod guard-cb-bad\\] GUARD: its code failed \\(call from another mod: guard-cb-lib\\): a memory access it may not make at .+\\+0x[0-9a-f]+, address 0x[0-9a-f]+\\. It is off until the next start; what it was changing may be half done\\."
    },
    {
      "fact": "mod.guard-cb-lib.cut",
      "absent": true
    },
    {
      "fact": "mod.guard-cb-lib.dependent_gone",
      "exists": true
    },
    {
      "fact": "takeout.guard-cb-bad",
      "exists": true
    },
    {
      "fact": "takeout.guard-cb-lib",
      "absent": true
    },
    {
      "fact": "takeout.guard-cb-good",
      "absent": true
    }
  ],
  "faults": [
    {
      "mod": "guard-cb-bad"
    }
  ]
}
