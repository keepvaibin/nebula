{
  "harness": 1,
  "name": "1601-before-access",
  "about": "guard-1-1 faults (access) in a before hook on MarioActor::control: caught at the boundary, the mod off and taken out at the next frame, GUARD in the log and the mod log, the game goes on",
  "proves": [
    "kernel.guard.resume",
    "kernel.guard.boundaries"
  ],
  "mods": [
    "../mods/guard-1-1"
  ],
  "stage": {
    "name": "EggStarGalaxy",
    "scenario": 1
  },
  "steps": [
    {
      "after": {
        "fact": "takeout.guard-1-1",
        "exists": true
      },
      "call": "MR::getRandom",
      "signature": "s32(s32, s32)",
      "args": [
        0,
        1601
      ],
      "fact": "after"
    },
    {
      "after": {
        "fact": "after",
        "exists": true
      },
      "end": true
    }
  ],
  "expect": [
    {
      "fact": "mod.guard-1-1.entered",
      "count": 1
    },
    {
      "fact": "mod.guard-1-1.survived",
      "absent": true
    },
    {
      "fact": "mod.guard-1-1.again",
      "absent": true
    },
    {
      "log": "\\[mod guard-1-1\\] GUARD: its code failed \\(before hook: MarioActor::control\\): a memory access it may not make at .+\\+0x[0-9a-f]+, address 0x[0-9a-f]+\\. It is off until the next start; what it was changing may be half done\\."
    },
    {
      "fact": "modlog",
      "has": {
        "mod": "guard-1-1",
        "source": "guard",
        "level": "error",
        "code": 1
      },
      "when": "any"
    },
    {
      "fact": "mod.guard-1-1.started",
      "is": 1
    },
    {
      "fact": "takeout.guard-1-1",
      "exists": true
    },
    {
      "fact": "after",
      "exists": true
    },
    {
      "fact": "kernel.guard_cost",
      "exists": true
    },
    {
      "log": "LumaCore: the guard's boundary costs \\d+ ticks per call more than a plain call"
    }
  ],
  "faults": [
    {
      "mod": "guard-1-1"
    }
  ]
}
