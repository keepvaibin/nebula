{
  "harness": 1,
  "name": "2401-draw-shapes",
  "about": "jd-shapes draws at hud.after every frame over the game's HUD: a red rectangle, a green outline 4 wide, a blue line 6 wide, a triangle blended red/green/blue, text in MessageFont26 (left at 40,120 and centred on 304), a 4x4 checker from pixels drawn nearest at 64x64, a yellow square clipped to 60x60 and a white square turned 45 degrees; every call LUMA_OK, text_measure's box and the advance whole units above 0; then its function removed: nothing drawn from the next frame (pictures f90 with every shape where draw.c places it: a person's look, then the reference; f130 the game's own picture again)",
  "proves": [
    "draw.point",
    "draw.shapes",
    "draw.text",
    "draw.clip",
    "draw.image",
    "draw.textures"
  ],
  "mods": [
    "../mods/jd-shapes"
  ],
  "stage": {
    "name": "EggStarGalaxy",
    "scenario": 1
  },
  "steps": [
    {
      "at": 60,
      "call": "MR::getRandom",
      "signature": "s32(s32, s32)",
      "args": [
        0,
        2401
      ]
    },
    {
      "at": 90,
      "picture": "f90"
    },
    {
      "at": 110,
      "call": "MR::getRandom",
      "signature": "s32(s32, s32)",
      "args": [
        0,
        2402
      ]
    },
    {
