{
  "harness": 1,
  "name": "2221-facts",
  "about": "facts: the system's platform, x64, the run's renderer, the disc's region and id, LumaCore 1.0, en-US, os and gpu empty",
  "proves": [
    "services.system"
  ],
  "mods": [
    "../mods/sys-facts"
  ],
  "steps": [
    {
      "at": 10,
      "call": "MR::getRandom",
      "signature": "s32(s32, s32)",
      "args": [
        0,
        4241
      ]
    },
    {
      "at": 20,
      "end": true
    }
  ],
  "expect": [
    {
      "fact": "mod.sys-facts.facts",
      "is": 0
    },
    {
      "fact": "mod.sys-facts.platform",
      "is": 0,
      "systems": [
        "windows"
      ]
    },
    {
      "fact": "mod.sys-facts.platform",
      "is": 1,
      "systems": [
        "linux"
      ]
    },
    {
      "fact": "mod.sys-facts.platform",
      "is": 3,
      "systems": [
        "macos"
      ]
    },
    {
      "fact": "mod.sys-facts.platform",
      "is": 2,
      "systems": [
        "android"
      ]
    },
    {
      "fact": "mod.sys-facts.platform",
      "is": 4,
      "systems": [
        "ios"
      ]
    },
    {
      "fact": "mod.sys-facts.arch",
      "is": 0
    },
    {
      "fact": "mod.sys-facts.renderer",
      "at_most": 1
    },
    {
      "fact": "mod.sys-facts.region",
      "is": 0
    },
    {
      "fact": "mod.sys-facts.lumacore_major",
      "is": 1
    },
    {
      "fact": "mod.sys-facts.lumacore_minor",
      "is": 0
    },
    {
      "fact": "mod.sys-facts.clipboard_images",
      "is": 1
    },
    {
      "fact": "mod.sys-facts.game_id_length",
      "is": 6
    },
    {
      "fact": "mod.sys-facts.game_id_region",
      "is": 69
    },
    {
      "fact": "mod.sys-facts.language_length",
      "at_least": 1
    },
    {
      "fact": "mod.sys-facts.version_length",
      "at_least": 1
    },
    {
      "fact": "mod.sys-facts.locale_en_us",
      "is": 1
    },
    {
      "fact": "mod.sys-facts.os_empty",
      "is": 1
    },
    {
      "fact": "mod.sys-facts.gpu_empty",
      "is": 1
    }
  ]
}
