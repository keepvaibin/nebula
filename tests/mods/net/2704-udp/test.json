{
  "harness": 1,
  "name": "2704-udp",
  "about": "UDP (1.1): a udp_open socket and a udp_connect socket over loopback: \"ping\" and an empty datagram one way, \"pong:ping\" back with send_to to the sender; the sender's address and port; SENT on each; the mistakes (send on udp_open, send_to on udp_connect, take on UDP, take_datagram outside a call: HANDLE; a far or v6 host: ARGUMENT; 65508 bytes: TOO_LARGE; net.internet udp_open and send_to: DENIED; its udp_connect to a loopback name: ERROR DENIED)",
  "proves": [
    "services.net.local",
    "services.net.internet",
    "services.net.udp",
    "services.registry"
  ],
  "mods": [
    "../mods/net-udp"
  ],
  "steps": [
    {
      "at": 10,
      "call": "MR::getRandom",
      "signature": "s32(s32, s32)",
      "args": [
        0,
        4501
      ]
    },
    {
      "at": 400,
      "call": "MR::getRandom",
      "signature": "s32(s32, s32)",
      "args": [
        0,
        4502
      ]
    },
    {
      "at": 420,
      "end": true
    }
  ],
