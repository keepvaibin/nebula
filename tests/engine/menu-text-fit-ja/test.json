{
  "harness": 1,
  "name": "menu-text-fit-ja",
  "about": "Every settings page in Japanese in the smallest window at the largest menu text: each text is narrowed, then cut short, inside its room; none runs past it (P-162). The System page is last: its picture waits for the renderer check's answers, which come from other processes at their own time.",
  "language": "JpJapanese",
  "disc": "RMGJ01",
  "window": [
    320,
    240
  ],
  "settings": [
    "GALAXY_MENU_TEXT_SIZE=200"
  ],
  "limit_seconds": 240,
  "steps": [
    {
      "at": 120,
      "settings": "display"
    },
    {
      "at": 160,
      "picture": "display"
    },
    {
      "at": 180,
      "settings": "graphics"
    },
    {
      "at": 220,
      "picture": "graphics"
    },
    {
      "at": 240,
      "settings": "controls"
    },
    {
      "at": 280,
      "picture": "controls"
    },
    {
      "at": 300,
      "settings": "audio"
    },
    {
      "at": 340,
      "picture": "audio"
    },
    {
      "at": 360,
      "settings": "general"
    },
    {
      "at": 400,
      "picture": "general"
    },
    {
      "at": 420,
      "settings": "mods"
    },
    {
      "at": 460,
      "picture": "mods"
    },
    {
      "at": 480,
      "settings": "advanced"
    },
    {
      "at": 520,
      "picture": "advanced"
    },
    {
      "at": 540,
      "settings": "system"
    },
    {
      "after": {
        "log": "\\[renderers\\] checked"
      },
      "picture": "system",
      "timeout": 1200
    },
    {
      "at": 1560,
      "end": true
    }
  ],
  "expect": [
    {
      "no_log": "runs past its room"
    }
  ]
}
