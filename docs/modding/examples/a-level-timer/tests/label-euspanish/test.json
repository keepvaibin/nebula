{
  "harness": 1,
  "name": "level-timer-label-euspanish",
  "about": "In EuSpanish the timer's label reads Tiempo (the mod's message line in the player's language)",
  "proves": [
    "kernel.hook.after"
  ],
  "mods": [
    "../.."
  ],
  "stage": {
    "name": "EggStarGalaxy",
    "scenario": 1
  },
  "language": "EuSpanish",
  "disc": "RMGP01",
  "steps": [
    {
      "at": 30,
      "end": true
    }
  ],
  "expect": [
    {
      "fact": "ui.text.2",
      "has": {
        "pane": "Label",
        "text": "Tiempo"
      },
      "when": "last"
    },
    {
      "fact": "mod.level-timer.opened",
      "is": true
    }
  ]
}
