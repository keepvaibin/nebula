    },
    {
      "at": 1470,
      "hold": [
        "A"
      ],
      "frames": 2
    },
    {
      "at": 1530,
      "picture": "list"
    },
    {
      "at": 1540,
      "hold": [
        "A"
      ],
      "frames": 2
    },
    {
      "at": 1569,
