    },
    {
      "at": 1660,
      "hold": [
        "B"
      ],
      "frames": 2
    },
    {
      "at": 1700,
      "picture": "back"
    },
    {
      "at": 1720,
      "end": true
    }
  ],
  "expect": [
    {
      "fact": "mod.ghost-time-trial.runs_listed",
      "is": 1
    },
    {
