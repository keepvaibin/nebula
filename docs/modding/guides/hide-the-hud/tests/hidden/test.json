{
  "harness": 1,
  "name": "hud-hidden",
  "about": "With Hide the HUD on, a galaxy starts with no counters and no life meter",
  "proves": [
    "kernel.hook.before"
  ],
  "mods": [
    "../.."
  ],
  "stage": {
    "name": "EggStarGalaxy",
    "scenario": 1
  },
  "steps": [
    {
      "at": 60,
      "call": "MR::isActiveDefaultGameLayout",
      "signature": "bool()",
      "fact": "hud_active"
    },
    {
      "at": 60,
