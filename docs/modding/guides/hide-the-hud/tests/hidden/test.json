    {
      "picture": "hidden",
      "box": [
        1050,
        100,
        60,
        60
      ],
      "mean_rgb": [
        18,
        39,
        97
      ],
      "within": 30
    },
    {
      "picture": "hidden",
      "box": [
        1085,
        550,
        130,
        90
      ],
      "mean_rgb": [
        252,
        243,
        99
      ],
      "within": 25
    }
  ]
}
