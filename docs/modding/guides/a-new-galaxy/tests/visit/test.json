{
  "harness": 1,
  "name": "orb-galaxy-visit",
  "about": "Entering the galaxy: Mario stands on the planet, Spikerolls near, and the galaxy's own music plays",
  "proves": ["kit.stage", "kit.actor", "services.audio.music"],
  "mods": ["../.."],
  "stage": {"name": "OrbKingGalaxy", "scenario": 1},
  "limit_seconds": 240,
  "steps": [
    {"at": 90, "picture": "start"},
    {"at": 100, "end": true}
  ],
  "expect": [
    {"fact": "stage.ready", "has": {"name": "OrbKingGalaxy"}},
    {"log": "kit.stage: music orb-galaxy:NebulaTheme over OrbKingGalaxy"},
    {"fact": "audio.music", "has": {"kind": "stream", "channels": 2, "rate": 32000, "looping": 1}},
    {"sound": [60, 95], "rms": [-45, 0]},
    {"picture": "start", "box": [440, 480, 400, 160], "mean_rgb": [60, 100, 100], "within": 40}
  ]
}
