{
  "harness": 1,
  "name": "orb-galaxy-visit",
  "about": "Entering the galaxy: Mario stands on the mossy planet, Spikerolls near, and the galaxy's own music plays",
  "proves": ["kit.stage", "kit.actor", "services.audio.music"],
  "mods": ["../../../lumakit", "../.."],
  "stage": { "name": "OrbKingGalaxy", "scenario": 1 },
  "limit_seconds": 240,
  "steps": [
    { "at": 90, "picture": "start" },
    { "at": 100, "end": true }
