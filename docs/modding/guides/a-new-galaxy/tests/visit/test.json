  "expect": [
    { "fact": "stage.ready", "has": { "name": "OrbKingGalaxy" } },
    { "log": "kit.stage: music orb-galaxy:NebulaTheme over OrbKingGalaxy" },
    { "picture": "start", "box": [440, 480, 400, 160], "mean_rgb": [100, 170, 120], "within": 60 }
  ]
}
