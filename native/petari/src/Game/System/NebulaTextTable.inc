     {u"Takes over {old}, which is still installed", nullptr, u"Reprend {old}, qui est encore install\u00E9", u"Reprend {old}, qui est encore install\u00E9", u"Reemplaza a {old}, que sigue instalado", u"Reemplaza a {old}, que sigue instalado", u"\u00DCbernimmt {old}, das noch installiert ist", u"Sostituisce {old}, che \u00E8 ancora installata", u"Neemt {old} over, dat nog ge\u00EFnstalleerd is", u"Substitui {old}, que ainda est\u00E1 instalado", u"\u307E\u3060\u5165\u3063\u3066\u3044\u308B{old}\u3092\u3072\u304D\u3064\u304E\u307E\u3059", u"\uC544\uC9C1 \uC124\uCE58\uB41C {old}\uC744(\uB97C) \uC774\uC5B4\uBC1B\uC2B5\uB2C8\uB2E4", u"\u63A5\u7BA1\u4ECD\u5DF2\u5B89\u88C5\u7684{old}", u"\u63A5\u7BA1\u4ECD\u5DF2\u5B89\u88DD\u7684{old}"}},
    {"Save.ChunkBroken",
     {u"Mods' data in file {file} could not be read; the file's game data loaded.", nullptr, u"Les donn\u00E9es des mods du fichier {file} n'ont pas pu \u00EAtre lues ; les donn\u00E9es de jeu du fichier ont \u00E9t\u00E9 charg\u00E9es.", u"Les donn\u00E9es des mods du fichier {file} n'ont pas pu \u00EAtre lues ; les donn\u00E9es de jeu du fichier ont \u00E9t\u00E9 charg\u00E9es.", u"No se pudieron leer los datos de los mods del archivo {file}; los datos de juego del archivo se cargaron.", u"No se pudieron leer los datos de los mods del archivo {file}; los datos de juego del archivo se cargaron.", u"Die Mod-Daten in Datei {file} konnten nicht gelesen werden; die Spieldaten der Datei wurden geladen.", u"Non \u00E8 stato possibile leggere i dati delle mod nel file {file}; i dati di gioco del file sono stati caricati.", u"De gegevens van mods in bestand {file} konden niet worden gelezen; de spelgegevens van het bestand zijn geladen.", u"N\u00E3o foi poss\u00EDvel ler os dados dos mods no arquivo {file}; os dados de jogo do arquivo foram carregados.", u"\u30D5\u30A1\u30A4\u30EB{file}\u306EMOD\u306E\u30C7\u30FC\u30BF\u3092\u8AAD\u307F\u8FBC\u3081\u307E\u305B\u3093\u3067\u3057\u305F\u3002\u30D5\u30A1\u30A4\u30EB\u306E\u30B2\u30FC\u30E0\u30C7\u30FC\u30BF\u306F\u8AAD\u307F\u8FBC\u307E\u308C\u307E\u3057\u305F\u3002", u"\uD30C\uC77C {file}\uC758 \uBAA8\uB4DC \uB370\uC774\uD130\uB97C \uC77D\uC744 \uC218 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4. \uD30C\uC77C\uC758 \uAC8C\uC784 \uB370\uC774\uD130\uB294 \uBD88\uB7EC\uC654\uC2B5\uB2C8\uB2E4.", u"\u65E0\u6CD5\u8BFB\u53D6\u6587\u4EF6{file}\u4E2D\u7684\u6A21\u7EC4\u6570\u636E\uFF1B\u8BE5\u6587\u4EF6\u7684\u6E38\u620F\u6570\u636E\u5DF2\u8F7D\u5165\u3002", u"\u7121\u6CD5\u8B80\u53D6\u6A94\u6848{file}\u4E2D\u7684\u6A21\u7D44\u8CC7\u6599\uFF1B\u8A72\u6A94\u6848\u7684\u904A\u6232\u8CC7\u6599\u5DF2\u8F09\u5165\u3002"}},
    {"Save.Exported",
     {u"{mod} read your file {file}.", nullptr, u"{mod} a lu votre fichier {file}.", u"{mod} a lu votre fichier {file}.", u"{mod} ley\u00F3 tu archivo {file}.", u"{mod} ley\u00F3 tu archivo {file}.", u"{mod} hat deine Datei {file} gelesen.", u"{mod} ha letto il tuo file {file}.", u"{mod} heeft je bestand {file} gelezen.", u"{mod} leu seu arquivo {file}.", u"{mod}\u304C\u30D5\u30A1\u30A4\u30EB{file}\u3092\u8AAD\u307F\u53D6\u308A\u307E\u3057\u305F\u3002", u"{mod}\uC774(\uAC00) \uD30C\uC77C {file}\uC744(\uB97C) \uC77D\uC5C8\uC2B5\uB2C8\uB2E4.", u"{mod}\u8BFB\u53D6\u4E86\u4F60\u7684\u6587\u4EF6{file}\u3002", u"{mod}\u8B80\u53D6\u4E86\u4F60\u7684\u6A94\u6848{file}\u3002"}},
    {"Save.Offered",
     {u"{mod} offered a file to replace file {file}.", nullptr, u"{mod} a propos\u00E9 un fichier pour remplacer le fichier {file}.", u"{mod} a propos\u00E9 un fichier pour remplacer le fichier {file}.", u"{mod} ofreci\u00F3 un archivo para reemplazar el archivo {file}.", u"{mod} ofreci\u00F3 un archivo para reemplazar el archivo {file}.", u"{mod} hat eine Datei angeboten, die Datei {file} ersetzen soll.", u"{mod} ha proposto un file per sostituire il file {file}.", u"{mod} bood een bestand aan om bestand {file} te vervangen.", u"{mod} ofereceu um arquivo para substituir o arquivo {file}.", u"{mod}\u304C\u30D5\u30A1\u30A4\u30EB{file}\u3068\u7F6E\u304D\u63DB\u3048\u308B\u30D5\u30A1\u30A4\u30EB\u3092\u9001\u308A\u307E\u3057\u305F\u3002", u"{mod}\uC774(\uAC00) \uD30C\uC77C {file}\uC744(\uB97C) \uB300\uCCB4\uD560 \uD30C\uC77C\uC744 \uC81C\uC548\uD588\uC2B5\uB2C8\uB2E4.", u"{mod}\u63D0\u4F9B\u4E86\u4E00\u4E2A\u6587\u4EF6\u6765\u66FF\u6362\u6587\u4EF6{file}\u3002", u"{mod}\u63D0\u4F9B\u4E86\u4E00\u500B\u6A94\u6848\u4F86\u53D6\u4EE3\u6A94\u6848{file}\u3002"}},
    {"Save.Replaced",
     {u"File {file} was replaced with the one {mod} offered.", nullptr, u"Le fichier {file} a \u00E9t\u00E9 remplac\u00E9 par celui propos\u00E9 par {mod}.", u"Le fichier {file} a \u00E9t\u00E9 remplac\u00E9 par celui propos\u00E9 par {mod}.", u"El archivo {file} se reemplaz\u00F3 por el que ofreci\u00F3 {mod}.", u"El archivo {file} se reemplaz\u00F3 por el que ofreci\u00F3 {mod}.", u"Datei {file} wurde durch die von {mod} angebotene ersetzt.", u"Il file {file} \u00E8 stato sostituito con quello proposto da {mod}.", u"Bestand {file} is vervangen door het bestand dat {mod} aanbood.", u"O arquivo {file} foi substitu\u00EDdo pelo que {mod} ofereceu.", u"\u30D5\u30A1\u30A4\u30EB{file}\u3092{mod}\u304C\u9001\u3063\u305F\u30D5\u30A1\u30A4\u30EB\u306B\u7F6E\u304D\u63DB\u3048\u307E\u3057\u305F\u3002", u"\uD30C\uC77C {file}\uC744(\uB97C) {mod}\uC774(\uAC00) \uC81C\uC548\uD55C \uD30C\uC77C\uB85C \uB300\uCCB4\uD588\uC2B5\uB2C8\uB2E4.", u"\u6587\u4EF6{file}\u5DF2\u66FF\u6362\u4E3A{mod}\u63D0\u4F9B\u7684\u6587\u4EF6\u3002", u"\u6A94\u6848{file}\u5DF2\u53D6\u4EE3\u70BA{mod}\u63D0\u4F9B\u7684\u6A94\u6848\u3002"}},
    {"Save.ChunkTooBig",
     {u"Mods' data did not fit in file {file}; the file was saved without it.", nullptr, u"Les donn\u00E9es des mods ne tenaient pas dans le fichier {file} ; le fichier a \u00E9t\u00E9 sauvegard\u00E9 sans elles.", u"Les donn\u00E9es des mods ne tenaient pas dans le fichier {file} ; le fichier a \u00E9t\u00E9 sauvegard\u00E9 sans elles.", u"Los datos de los mods no cab\u00EDan en el archivo {file}; el archivo se guard\u00F3 sin ellos.", u"Los datos de los mods no cab\u00EDan en el archivo {file}; el archivo se guard\u00F3 sin ellos.", u"Die Mod-Daten passten nicht in Datei {file}; die Datei wurde ohne sie gespeichert.", u"I dati delle mod non entravano nel file {file}; il file \u00E8 stato salvato senza di essi.", u"De gegevens van mods pasten niet in bestand {file}; het bestand is zonder die gegevens opgeslagen.", u"Os dados dos mods n\u00E3o couberam no arquivo {file}; o arquivo foi salvo sem eles.", u"MOD\u306E\u30C7\u30FC\u30BF\u304C\u30D5\u30A1\u30A4\u30EB{file}\u306B\u5165\u308A\u304D\u308A\u307E\u305B\u3093\u3067\u3057\u305F\u3002\u30D5\u30A1\u30A4\u30EB\u306FMOD\u306E\u30C7\u30FC\u30BF\u306A\u3057\u3067\u30BB\u30FC\u30D6\u3055\u308C\u307E\u3057\u305F\u3002", u"\uBAA8\uB4DC \uB370\uC774\uD130\uAC00 \uD30C\uC77C {file}\uC5D0 \uB4E4\uC5B4\uAC00\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4. \uD30C\uC77C\uC740 \uBAA8\uB4DC \uB370\uC774\uD130 \uC5C6\uC774 \uC800\uC7A5\uB418\uC5C8\uC2B5\uB2C8\uB2E4.", u"\u6A21\u7EC4\u6570\u636E\u65E0\u6CD5\u653E\u5165\u6587\u4EF6{file}\uFF1B\u8BE5\u6587\u4EF6\u5DF2\u4FDD\u5B58\uFF0C\u4F46\u4E0D\u542B\u6A21\u7EC4\u6570\u636E\u3002", u"\u6A21\u7D44\u8CC7\u6599\u7121\u6CD5\u653E\u5165\u6A94\u6848{file}\uFF1B\u8A72\u6A94\u6848\u5DF2\u5132\u5B58\uFF0C\u4F46\u4E0D\u542B\u6A21\u7D44\u8CC7\u6599\u3002"}},
    {"Save.GlobalBroken",
     {u"This mod's values kept across files could not be read; they start empty.", nullptr, u"Les valeurs de ce mod conserv\u00E9es entre les fichiers n'ont pas pu \u00EAtre lues ; elles repartent de z\u00E9ro.", u"Les valeurs de ce mod conserv\u00E9es entre les fichiers n'ont pas pu \u00EAtre lues ; elles repartent de z\u00E9ro.", u"No se pudieron leer los valores de este mod guardados entre archivos; empiezan vac\u00EDos.", u"No se pudieron leer los valores de este mod guardados entre archivos; empiezan vac\u00EDos.", u"Die datei\u00FCbergreifend gespeicherten Werte dieser Mod konnten nicht gelesen werden; sie beginnen leer.", u"Non \u00E8 stato possibile leggere i valori di questa mod conservati tra i file; ripartono vuoti.", u"De waarden van deze mod die over bestanden heen bewaard worden, konden niet worden gelezen; ze beginnen leeg.", u"N\u00E3o foi poss\u00EDvel ler os valores deste mod guardados entre arquivos; eles come\u00E7am vazios.", u"\u30D5\u30A1\u30A4\u30EB\u3092\u307E\u305F\u3044\u3067\u4FDD\u5B58\u3055\u308C\u305F\u3053\u306EMOD\u306E\u5024\u3092\u8AAD\u307F\u8FBC\u3081\u307E\u305B\u3093\u3067\u3057\u305F\u3002\u5024\u306F\u7A7A\u304B\u3089\u59CB\u307E\u308A\u307E\u3059\u3002", u"\uD30C\uC77C \uAC04\uC5D0 \uC800\uC7A5\uB41C \uC774 \uBAA8\uB4DC\uC758 \uAC12\uC744 \uC77D\uC744 \uC218 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4. \uAC12\uC740 \uBE44\uC5B4 \uC788\uB294 \uC0C1\uD0DC\uB85C \uC2DC\uC791\uD569\uB2C8\uB2E4.", u"\u65E0\u6CD5\u8BFB\u53D6\u6B64\u6A21\u7EC4\u8DE8\u6587\u4EF6\u4FDD\u5B58\u7684\u6570\u503C\uFF1B\u6570\u503C\u5C06\u4ECE\u7A7A\u5F00\u59CB\u3002", u"\u7121\u6CD5\u8B80\u53D6\u6B64\u6A21\u7D44\u8DE8\u6A94\u6848\u4FDD\u5B58\u7684\u6578\u503C\uFF1B\u6578\u503C\u5C07\u5F9E\u7A7A\u958B\u59CB\u3002"}},
    {"Save.GlobalWriteFailed",
     {u"This mod's values kept across files could not be written; they will be written again shortly.", nullptr, u"Les valeurs de ce mod conserv\u00E9es entre les fichiers n'ont pas pu \u00EAtre \u00E9crites ; une nouvelle tentative suivra sous peu.", u"Les valeurs de ce mod conserv\u00E9es entre les fichiers n'ont pas pu \u00EAtre \u00E9crites ; une nouvelle tentative suivra sous peu.", u"No se pudieron escribir los valores de este mod guardados entre archivos; se volver\u00E1 a intentar en breve.", u"No se pudieron escribir los valores de este mod guardados entre archivos; se volver\u00E1 a intentar en breve.", u"Die datei\u00FCbergreifend gespeicherten Werte dieser Mod konnten nicht geschrieben werden; es wird gleich erneut versucht.", u"Non \u00E8 stato possibile scrivere i valori di questa mod conservati tra i file; a breve si riprover\u00E0.", u"De waarden van deze mod die over bestanden heen bewaard worden, konden niet worden geschreven; het wordt zo opnieuw geprobeerd.", u"N\u00E3o foi poss\u00EDvel gravar os valores deste mod guardados entre arquivos; uma nova tentativa ser\u00E1 feita em breve.", u"\u30D5\u30A1\u30A4\u30EB\u3092\u307E\u305F\u3044\u3067\u4FDD\u5B58\u3055\u308C\u305F\u3053\u306EMOD\u306E\u5024\u3092\u66F8\u304D\u8FBC\u3081\u307E\u305B\u3093\u3067\u3057\u305F\u3002\u3057\u3070\u3089\u304F\u3057\u3066\u304B\u3089\u3082\u3046\u4E00\u5EA6\u66F8\u304D\u8FBC\u307F\u307E\u3059\u3002", u"\uD30C\uC77C \uAC04\uC5D0 \uC800\uC7A5\uB41C \uC774 \uBAA8\uB4DC\uC758 \uAC12\uC744 \uAE30\uB85D\uD560 \uC218 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4. \uB098\uC911\uC5D0 \uB2E4\uC2DC \uAE30\uB85D\uD569\uB2C8\uB2E4.", u"\u65E0\u6CD5\u5199\u5165\u6B64\u6A21\u7EC4\u8DE8\u6587\u4EF6\u4FDD\u5B58\u7684\u6570\u503C\uFF1B\u7A0D\u540E\u5C06\u518D\u6B21\u5C1D\u8BD5\u5199\u5165\u3002", u"\u7121\u6CD5\u5BEB\u5165\u6B64\u6A21\u7D44\u8DE8\u6A94\u6848\u4FDD\u5B58\u7684\u6578\u503C\uFF1B\u7A0D\u5F8C\u5C07\u518D\u6B21\u5617\u8A66\u5BEB\u5165\u3002"}},
    {"Mods.OptionUnknown",
     {u"{mod} asked for an option it does not have: {key}.", nullptr, u"{mod} a demand\u00E9 une option qu'il n'a pas : {key}.", u"{mod} a demand\u00E9 une option qu'il n'a pas : {key}.", u"{mod} pidi\u00F3 una opci\u00F3n que no tiene: {key}.", u"{mod} pidi\u00F3 una opci\u00F3n que no tiene: {key}.", u"{mod} hat eine Option abgefragt, die es nicht hat: {key}.", u"{mod} ha chiesto un'opzione che non ha: {key}.", u"{mod} vroeg om een optie die het niet heeft: {key}.", u"{mod} pediu uma op\u00E7\u00E3o que n\u00E3o tem: {key}.", u"{mod} \u306F\u6301\u3063\u3066\u3044\u306A\u3044\u8A2D\u5B9A\u3092\u305F\u305A\u306D\u307E\u3057\u305F: {key}", u"{mod}\uC774(\uAC00) \uC5C6\uB294 \uC635\uC158\uC744 \uC694\uCCAD\uD588\uC2B5\uB2C8\uB2E4: {key}", u"{mod} \u8BF7\u6C42\u4E86\u5B83\u6CA1\u6709\u7684\u9009\u9879\uFF1A{key}\u3002", u"{mod} \u8981\u6C42\u4E86\u5B83\u6C92\u6709\u7684\u9078\u9805\uFF1A{key}\u3002"}},
    {"Mods.OptionNotOwn",
