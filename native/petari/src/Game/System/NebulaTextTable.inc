    {"S.THIS_MOD_RUNS_ITS_OWN_CODE_AND_CAN_DO_ANYTHING_ON_THIS_DEVICE._ALLOW_IT?__ENTER/Y_YES__ESC/B_NO",
     {u"This mod runs its own code and can do anything on this device. Allow it?  Enter/Y yes  Esc/B no", nullptr, u"Ce mod ex\u00E9cute son propre code et peut tout faire sur cet appareil. L'autoriser ?  Entr\u00E9e/Y oui  \u00C9chap/B non", u"Ce mod ex\u00E9cute son propre code et peut tout faire sur cet appareil. L'autoriser ?  Entr\u00E9e/Y oui  \u00C9chap/B non", u"Este mod ejecuta su propio c\u00F3digo y puede hacer cualquier cosa en este dispositivo. \u00BFPermitirlo?  Intro/Y s\u00ED  Esc/B no", u"Este mod ejecuta su propio c\u00F3digo y puede hacer cualquier cosa en este dispositivo. \u00BFPermitirlo?  Intro/Y s\u00ED  Esc/B no", u"Dieser Mod f\u00FChrt eigenen Code aus und kann auf diesem Ger\u00E4t alles tun. Erlauben?  Eingabe/Y ja  Esc/B nein", u"Questa mod esegue codice proprio e pu\u00F2 fare qualsiasi cosa su questo dispositivo. Consentirla?  Invio/Y s\u00EC  Esc/B no", u"Deze mod voert eigen code uit en kan alles doen op dit apparaat. Toestaan?  Enter/Y ja  Esc/B nee", u"Este mod executa o pr\u00F3prio c\u00F3digo e pode fazer qualquer coisa neste dispositivo. Permitir?  Enter/Y sim  Esc/B n\u00E3o", u"\u3053\u306EMOD\u306F\u3069\u304F\u3058\u306E\u30B3\u30FC\u30C9\u3092\u3058\u3063\u3053\u3046\u3057\u3001\u3053\u306E\u305F\u3093\u307E\u3064\u3067\u4F55\u3067\u3082\u3067\u304D\u307E\u3059\u3002\u304D\u3087\u304B\u3057\u307E\u3059\u304B\uFF1F  Enter/Y \u306F\u3044  Esc/B \u3044\u3044\u3048", u"\uC774 \uBAA8\uB4DC\uB294 \uC790\uCCB4 \uCF54\uB4DC\uB97C \uC2E4\uD589\uD558\uBA70 \uC774 \uAE30\uAE30\uC5D0\uC11C \uBB34\uC5C7\uC774\uB4E0 \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uD5C8\uC6A9\uD560\uAE4C\uC694?  Enter/Y \uC608  Esc/B \uC544\uB2C8\uC694", u"\u6B64\u6A21\u7EC4\u4F1A\u8FD0\u884C\u81EA\u5DF1\u7684\u4EE3\u7801\uFF0C\u53EF\u4EE5\u5728\u6B64\u8BBE\u5907\u4E0A\u6267\u884C\u4EFB\u4F55\u64CD\u4F5C\u3002\u5141\u8BB8\u5417\uFF1F  Enter/Y \u662F  Esc/B \u5426", u"\u6B64\u6A21\u7D44\u6703\u57F7\u884C\u81EA\u5DF1\u7684\u7A0B\u5F0F\u78BC\uFF0C\u53EF\u4EE5\u5728\u6B64\u88DD\u7F6E\u4E0A\u57F7\u884C\u4EFB\u4F55\u64CD\u4F5C\u3002\u5141\u8A31\u55CE\uFF1F  Enter/Y \u662F  Esc/B \u5426"}},
    {"SettingsModsCodeAsk",
     {u"This mod runs its own code and can do anything on this device. Only allow mods you trust.", nullptr, u"Ce mod ex\u00E9cute son propre code et peut tout faire sur cet appareil. N'autorisez que les mods de confiance.", u"Ce mod ex\u00E9cute son propre code et peut tout faire sur cet appareil. N'autorisez que les mods de confiance.", u"Este mod ejecuta su propio c\u00F3digo y puede hacer cualquier cosa en este dispositivo. Permite solo mods de confianza.", u"Este mod ejecuta su propio c\u00F3digo y puede hacer cualquier cosa en este dispositivo. Permite solo mods de confianza.", u"Dieser Mod f\u00FChrt eigenen Code aus und kann auf diesem Ger\u00E4t alles tun. Erlaube nur Mods, denen du vertraust.", u"Questa mod esegue codice proprio e pu\u00F2 fare qualsiasi cosa su questo dispositivo. Consenti solo mod di cui ti fidi.", u"Deze mod voert eigen code uit en kan alles doen op dit apparaat. Sta alleen mods toe die je vertrouwt.", u"Este mod executa o pr\u00F3prio c\u00F3digo e pode fazer qualquer coisa neste dispositivo. Permita apenas mods de confian\u00E7a.", u"\u3053\u306EMOD\u306F\u3069\u304F\u3058\u306E\u30B3\u30FC\u30C9\u3092\u3058\u3063\u3053\u3046\u3057\u3001\u3053\u306E\u305F\u3093\u307E\u3064\u3067\u4F55\u3067\u3082\u3067\u304D\u307E\u3059\u3002\u4FE1\u983C\u3067\u304D\u308BMOD\u3060\u3051\u3092\u304D\u3087\u304B\u3057\u3066\u304F\u3060\u3055\u3044\u3002", u"\uC774 \uBAA8\uB4DC\uB294 \uC790\uCCB4 \uCF54\uB4DC\uB97C \uC2E4\uD589\uD558\uBA70 \uC774 \uAE30\uAE30\uC5D0\uC11C \uBB34\uC5C7\uC774\uB4E0 \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC2E0\uB8B0\uD558\uB294 \uBAA8\uB4DC\uB9CC \uD5C8\uC6A9\uD558\uC138\uC694.", u"\u6B64\u6A21\u7EC4\u4F1A\u8FD0\u884C\u81EA\u5DF1\u7684\u4EE3\u7801\uFF0C\u53EF\u4EE5\u5728\u6B64\u8BBE\u5907\u4E0A\u6267\u884C\u4EFB\u4F55\u64CD\u4F5C\u3002\u8BF7\u53EA\u5141\u8BB8\u4F60\u4FE1\u4EFB\u7684\u6A21\u7EC4\u3002", u"\u6B64\u6A21\u7D44\u6703\u57F7\u884C\u81EA\u5DF1\u7684\u7A0B\u5F0F\u78BC\uFF0C\u53EF\u4EE5\u5728\u6B64\u88DD\u7F6E\u4E0A