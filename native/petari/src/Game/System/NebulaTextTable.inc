    {"SettingsModRemoveAsk",
     {u"Remove this mod? Its folder is deleted for good.", nullptr, u"Supprimer ce mod ? Son dossier sera d\u00E9finitivement effac\u00E9.", u"Supprimer ce mod ? Son dossier sera d\u00E9finitivement effac\u00E9.", u"\u00BFQuitar este mod? Su carpeta se borrar\u00E1 para siempre.", u"\u00BFQuitar este mod? Su carpeta se borrar\u00E1 para siempre.", u"Diese Mod entfernen? Ihr Ordner wird endg\u00FCltig gel\u00F6scht.", u"Rimuovere questa mod? La sua cartella verr\u00E0 eliminata definitivamente.", u"Deze mod verwijderen? De map wordt definitief gewist.", u"Remover este mod? A pasta dele ser\u00E1 apagada para sempre.", u"\u3053\u306EMOD\u3092\u6D88\u3057\u307E\u3059\u304B\uFF1F\u30D5\u30A9\u30EB\u30C0\u30FC\u306F\u5B8C\u5168\u306B\u6D88\u3048\u307E\u3059\u3002", u"\uC774 \uBAA8\uB4DC\uB97C \uC81C\uAC70\uD560\uAE4C\uC694? \uD3F4\uB354\uAC00 \uC601\uAD6C\uC801\uC73C\uB85C \uC0AD\uC81C\uB429\uB2C8\uB2E4.", u"\u8981\u79FB\u9664\u6B64\u6A21\u7EC4\u5417\uFF1F\u5176\u6587\u4EF6\u5939\u5C06\u88AB\u6C38\u4E45\u5220\u9664\u3002", u"\u8981\u79FB\u9664\u6B64\u6A21\u7D44\u55CE\uFF1F\u5176\u8CC7\u6599\u593E\u5C07\u88AB\u6C38\u4E45\u522A\u9664\u3002"}},
    {"SettingsModRemoveAskBin",
     {u"Remove this mod? Its folder goes to the Recycle Bin.", nullptr, u"Supprimer ce mod ? Son dossier ira dans la corbeille.", u"Supprimer ce mod ? Son dossier ira dans la corbeille.", u"\u00BFQuitar este mod? Su carpeta ir\u00E1 a la papelera.", u"\u00BFQuitar este mod? Su carpeta ir\u00E1 a la papelera.", u"Diese Mod entfernen? Ihr Ordner kommt in den Papierkorb.", u"Rimuovere questa mod? La sua cartella andr\u00E0 nel Cestino.", u"Deze mod verwijderen? De map gaat naar de prullenbak.", u"Remover este mod? A pasta dele ir\u00E1 para a Lixeira.", u"\u3053\u306EMOD\u3092\u6D88\u3057\u307E\u3059\u304B\uFF1F\u30D5\u30A9\u30EB\u30C0\u30FC\u306F\u3054\u307F\u7BB1\u306B\u79FB\u52D5\u3057\u307E\u3059\u3002", u"\uC774 \uBAA8\uB4DC\uB97C \uC81C\uAC70\uD560\uAE4C\uC694? \uD3F4\uB354\uB294 \uD734\uC9C0\uD1B5\uC73C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4.", u"\u8981\u79FB\u9664\u6B64\u6A21\u7EC4\u5417\uFF1F\u5176\u6587\u4EF6\u5939\u5C06\u79FB\u5230\u56DE\u6536\u7AD9\u3002", u"\u8981\u79FB\u9664\u6B64\u6A21\u7D44\u55CE\uFF1F\u5176\u8CC7\u6599\u593E\u5C07\u79FB\u81F3\u8CC7\u6E90\u56DE\u6536\u7B52\u3002"}},
    {"SettingsModForgetAsk",
