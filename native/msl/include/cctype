/* MSL's <cctype>: "C"-locale classification with MSL's results (the class bit; 0 outside 0..0xFF). */
#ifndef NEBULA_MSL_CCTYPE
#define NEBULA_MSL_CCTYPE
static inline int isalpha(int c) {
    return ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')) ? 0x1 : 0;
}
static inline int isdigit(int c) {
    return (c >= '0' && c <= '9') ? 0x8 : 0;
}
static inline int isspace(int c) {
    return (c == ' ' || (c >= '\t' && c <= '\r')) ? 0x100 : 0;
}
static inline int isupper(int c) {
    return (c >= 'A' && c <= 'Z') ? 0x200 : 0;
}
static inline int isxdigit(int c) {
    return ((c >= '0' && c <= '9') || (c >= 'A' && c <= 'F') || (c >= 'a' && c <= 'f')) ? 0x400 : 0;
}
static inline int toupper(int c) {
    return (c >= 'a' && c <= 'z') ? c - ('a' - 'A') : c;
}
static inline int tolower(int c) {
    return (c >= 'A' && c <= 'Z') ? c + ('a' - 'A') : c;
}
#endif
