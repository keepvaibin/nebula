<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The renderer: Vulkan 1.1. -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />
    <!-- The microphone and camera are a mod's (capture.audio, capture.video): a device without them installs the
         game; without these rows the permissions below would make both required. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Controller rumble and the touch controls' feedback. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Setup copies the game from the disc image in a foreground service, with its progress as a notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Plan 2.9: what mods' services need, which no mod can add after release. Each is used only once the player
         allowed a mod that service (consent), and the dangerous ones are asked for then, never at the start.
         Sockets (net.local, net.internet); whether there is a network; the local network's broadcast and multicast
         (finding a peer). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- LumaCore's capture services, audio.microphone and capture.camera: asked of the player only when a
         mod that declares the permission is consented to and opens the device (runtime/src/luma_capture.cpp may_use,
         through SDL's request); neither is required to install. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Nebula"
        android:appCategory="game"
        android:allowBackup="false"
        android:hasFragileUserData="true"
        android:enableOnBackInvokedCallback="false"
        android:hardwareAccelerated="true">

        <!-- Profilers (simpleperf, Android Studio) may sample a release build over adb: the shell user only. -->
        <profileable android:shell="true" />

        <!-- The launcher: setup, play, settings. Standard launch mode: the app's icon brings back a running game
             rather than clearing it. -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:theme="@style/Theme.Nebula.Launcher"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A DolphinBar plugged in (Wii Remotes over USB): Android offers Nebula, and "always" lets the game
                 open the bar from then on without asking (WiimoteUsb). -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/wiimote_usb" />
            <!-- "Open with Nebula" on a mod (a .luma has no type of its own: by its name; archives by their type) and
                 Share to Nebula: the files go where a drop on the launcher would (LauncherModel.dropped). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.luma" />
                <data android:pathPattern=".*\\..*\\.luma" />
                <data android:pathPattern=".*\\..*\\..*\\.luma" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/x-7z-compressed" />
                <data android:mimeType="application/vnd.rar" />
                <data android:mimeType="application/x-rar-compressed" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- nebula:// links (6.1's import by link, mods.install from a page): Nebula comes to the front; the link
                 itself waits on net.internet (LauncherActivity.opened). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nebula" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
            </intent-filter>
        </activity>

        <!-- The game, in its own process: one run per process (the native game starts once). -->
        <activity
            android:name=".GameActivity"
            android:exported="${gameExported}"
            android:process=":game"
            android:theme="@style/Theme.Nebula.Game"
            android:screenOrientation="fullUser"
            android:resizeableActivity="true"
            android:preferMinimalPostProcessing="true"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|density" />

        <service
            android:name=".ImportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>
    </application>

</manifest>
