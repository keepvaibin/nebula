<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nebula.entitlements for a build with no mod support (build_macos.sh -n): the microphone and the camera are a mod's
     (capture.audio, capture.video), so neither key is here, and the app is refused both without the player being asked.
     The game module is signed as the app is, by no team: disable-library-validation, as in Nebula.entitlements. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
